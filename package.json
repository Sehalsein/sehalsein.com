{
  "name": "sehalsein.com",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/experience",
    "test:browser": "node scripts/studio/check.mjs && node scripts/studio/viewports.mjs",
    "deploy": "bun run build && wrangler deploy --config wrangler.jsonc",
    "test:motion": "node scripts/studio/check.mjs",
    "record:room": "node scripts/studio/record.mjs",
    "assets:compress": "node scripts/studio/compress.mjs"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.0",
    "meshoptimizer": "1.1.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
